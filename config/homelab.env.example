# Homelab settings: the template for config/homelab.env (gitignored).
# You don't copy this by hand: `bin/homelab setup` asks for what it can't detect and writes the file.
# Later, edit on http://<HL_HOST>:8090/settings or by hand, then `bin/homelab apply`.
#
# Format: help comments right above each key, plus marker lines the setup wizard reads:
#   # secret            never shown in the web UI
#   # generate          setup fills in a random value
#   # detect: <what>    setup suggests a value found on this machine
#   # optional          may stay empty
#   # example: <value>  shown as a hint
# Keep comments on their own lines (systemd reads this file too).

# ── this machine ──────────────────────────────────────────────────────────

# Hostname on the LAN / Tailscale (MagicDNS). Also the AirPlay receiver and Claude session name.
# detect: hostname
HL_HOST=
# LAN IP of this machine. Private routes (docs, n8n MCP) answer to it.
# detect: lan_ip
HL_LAN_IP=
# Tailscale IP of this machine. Empty if you don't use Tailscale.
# detect: tailscale_ip
# optional
HL_TAILSCALE_IP=
# Network interface (Wi-Fi / Ethernet), used to count devices on the dashboard.
# detect: lan_iface
HL_LAN_IFACE=
# Time zone for n8n and the dashboard.
# detect: timezone
TZ=

# ── internet (Cloudflare) ─────────────────────────────────────────────────
# Leave these empty to keep everything on your LAN / Tailscale for now.

# Your domain on Cloudflare. Apps live on <app>.DOMAIN through the tunnel.
# example: example.com
# optional
DOMAIN=
# Cloudflare tunnel UUID (`cloudflared tunnel list`). Its credentials JSON lives in /etc/cloudflared/.
# detect: cf_tunnel
# optional
CF_TUNNEL_ID=
# Cloudflare Zero Trust team name: the <team> in <team>.cloudflareaccess.com. Used for n8n single sign-on.
# example: myteam
# optional
CF_ACCESS_TEAM=
# Application Audience (AUD) tag of the Cloudflare Access app in front of n8n (Access app > Overview).
# optional
CF_ACCESS_AUD=
# Public hostname for the screen remote + settings page, routed to screenctl :8090.
# Set it ONLY after a Cloudflare Access app protects this hostname: screenctl has no login of its own.
# example: remote.example.com
# optional
SCREEN_REMOTE_HOST=

# diops-bots results site (host service :8097) on a public hostname, e.g. diops.example.com.
# Only after a Cloudflare Access app protects it. optional
DIOPS_WEB_HOST=

# ── secrets (generated) ───────────────────────────────────────────────────

# n8n Postgres password.
# secret
# generate
POSTGRES_PASSWORD=
# n8n credential encryption key. Losing it makes every stored n8n credential unreadable: back it up.
# secret
# generate
N8N_ENCRYPTION_KEY=
# Token that unlocks the settings page and API.
# secret
# generate
SETTINGS_TOKEN=
# Token your Mac / iPhone uses to send calendar, reminders and notes (clients/macos).
# secret
# generate
PUSH_TOKEN=
