# Homelab settings. `bin/homelab setup` copies this to config/homelab.env (gitignored).
# Edit them on http://<HL_HOST>:8090/settings or by hand, then `bin/homelab apply`.
# Format: help comments right above each key; a "# secret" line marks secrets
# (never shown in the web UI). Keep comments on their own lines (systemd reads this file too).

# Hostname of this machine on the LAN / Tailscale (MagicDNS). Also the AirPlay / Claude session name.
HL_HOST=homelab
# LAN IP of this machine (private routes accept it as a Host header).
HL_LAN_IP=192.168.1.10
# Tailscale IP of this machine.
HL_TAILSCALE_IP=100.64.0.1
# Wi-Fi / Ethernet interface, used to count LAN devices on the dashboard.
HL_LAN_IFACE=wlan0
# Time zone for n8n and the dashboard.
TZ=Europe/London

# Public domain routed through the Cloudflare tunnel; apps live on <app>.DOMAIN.
DOMAIN=example.com
# Cloudflare tunnel UUID (`cloudflared tunnel list`). Its credentials JSON lives in /etc/cloudflared/.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
# Cloudflare Zero Trust team name (<team>.cloudflareaccess.com).
CF_ACCESS_TEAM=myteam
# Application Audience (AUD) tag of the Cloudflare Access app in front of n8n.
CF_ACCESS_AUD=

# n8n Postgres password.
# secret
POSTGRES_PASSWORD=
# n8n credential encryption key. Losing it makes every stored n8n credential unreadable.
# secret
N8N_ENCRYPTION_KEY=

# Token for the settings page and API. `bin/homelab setup` generates one.
# secret
SETTINGS_TOKEN=
