[Unit]
Description=Claude Code Remote Control (homelab admin)
After=network-online.target

[Service]
EnvironmentFile=/srv/homelab/config/public.env
Type=forking
WorkingDirectory=/srv/homelab
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s claude -c /srv/homelab "claude remote-control --name ${HL_HOST} --permission-mode auto"
ExecStop=/usr/bin/tmux kill-session -t claude
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
