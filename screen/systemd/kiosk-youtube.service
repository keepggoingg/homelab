[Unit]
Description=Chromium YouTube TV (always loaded, cast target), workspace 2
PartOf=sway-session.target
After=sway-session.target

[Service]
ExecStart=/snap/bin/chromium --kiosk --class=kiosk-youtube --ozone-platform=wayland \
  --remote-debugging-port=9223 --remote-allow-origins=http://127.0.0.1:9223 \
  --user-agent="Mozilla/5.0 (Linux; Tizen 6.5) AppleWebKit/537.36 (KHTML, like Gecko) 85.0.4183.93/6.5 TV Safari/537.36" \
  --autoplay-policy=no-user-gesture-required --noerrdialogs --disable-session-crashed-bubble --disable-infobars \
  --password-store=basic --no-first-run --check-for-update-interval=31536000 --enable-features=VaapiVideoDecoder --disable-features=Translate,TranslateUI --disable-translate \
  https://www.youtube.com/tv
Restart=always
RestartSec=3

[Install]
WantedBy=sway-session.target
