[Unit]
Description=homelab web remote, settings and display control (HTTP :8090)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /srv/homelab/screen/screenctl.py
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=3

[Install]
# boots with the user manager (enable lingering on headless boxes: sudo loginctl enable-linger $USER)
WantedBy=default.target
