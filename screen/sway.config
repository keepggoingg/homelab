# homelab kiosk display. Managed in /srv/homelab/screen.
set $mod Mod4
output * bg #0e0d0b solid_color
output eDP-1 scale 1
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 2000
# one workspace per mode, nothing is ever reloaded when switching:
#   1 kiosk-shell (dashboard + fireplace)  2 kiosk-youtube (YouTube TV)  3 overlays (mpv, AirPlay)
# screenctl.py places every new window (sway rules fire before Chromium sets its app_id).
workspace_auto_back_and_forth no
# idle: never blank (screenctl controls power)
exec systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec systemctl --user start sway-session.target
bindsym $mod+Shift+e exit
